<?xml version="1.0" encoding="utf-8"?>
<!--
  NeonCalc launcher icon — dark rounded tile, crescent moon and a
  glowing "=" — pure vector, no binary PNG assets needed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- rounded tile background -->
    <path
        android:fillColor="#0E0E16"
        android:pathData="M24,0 L84,0 A24,24 0 0 1 108,24 L108,84 A24,24 0 0 1 84,108 L24,108 A24,24 0 0 1 0,84 L0,24 A24,24 0 0 1 24,0 Z" />

    <!-- crescent moon -->
    <path
        android:fillColor="#B26BFF"
        android:pathData="M70,30 A24,24 0 1 0 70,78 A19,19 0 1 1 70,30 Z" />

    <!-- neon "=" bars -->
    <path
        android:strokeColor="#00F0FF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M36,66 L72,66" />
    <path
        android:strokeColor="#FF4FD8"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M36,78 L72,78" />
</vector>
