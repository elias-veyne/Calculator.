<?xml version="1.0" encoding="utf-8"?>
<!-- Platform theme used before Compose takes over (deep-black, no action bar) -->
<resources>
    <style name="Theme.NeonCalc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_void</item>
        <item name="android:statusBarColor">@color/bg_void</item>
        <item name="android:navigationBarColor">@color/bg_void</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
